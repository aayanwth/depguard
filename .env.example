# DepGuard Environment Variables

# GitHub (Required for GitHub Ingestion)
GITHUB_TOKEN=

# Snowflake (Required for Snowflake integration)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=depguard_wh
SNOWFLAKE_DATABASE=depguard_db
SNOWFLAKE_ROLE=depguard_role

# dlt Configuration
# Set to 'duckdb' for local testing, 'snowflake' for production
DESTINATION_NAME=duckdb
